<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>InvestRright Capital | Long-Short Equity AIF Category III</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600;700;800&family=Inter:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,500;0,600;0,700;0,800;1,400;1,600&display=swap" rel="stylesheet">
  <style>
.ir-master-wrap {
  width: 100%;
  min-height: 100vh;
  position: relative;
  overflow-x: hidden;
  background-color: #FAF8F3;
}

.ir-header {
  position: sticky;
  top: 0;
  left: 0;
  width: 100%;
  height: 76px;
  background-color: #FAF8F3;
  border-bottom: 1px solid rgba(188, 167, 99, 0.25);
  box-shadow: 0 4px 20px rgba(0, 40, 20, 0.04);
  z-index: 1000;
  display: flex;
  align-items: center;
}

.ir-nav-container {
  width: 100%;
  max-width: 1360px;
  margin: 0 auto;
  padding: 0 36px;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.ir-logo-link {
  display: flex;
  align-items: center;
  text-decoration: none;
  height: 52px;
}

.ir-logo-svg {
  width: 250px;
  height: 65px;
  display: block;
}

.ir-nav-menu {
  display: flex;
  align-items: center;
  gap: 32px;
}

.ir-nav-link {
  font-family: 'Inter', sans-serif;
  font-size: 15px;
  font-weight: 500;
  color: #004020;
  text-decoration: none;
  padding: 8px 4px;
  position: relative;
  transition: color 0.2s ease;
  display: inline-flex;
  align-items: center;
  gap: 4px;
}

.ir-nav-link:hover {
  color: #BCA763;
}

.ir-nav-active {
  border-bottom: 2px solid #BCA763;
  color: #004020;
  font-weight: 600;
}

.ir-arrow-icon {
  font-size: 10px;
  margin-left: 2px;
  color: #BCA763;
  transition: transform 0.2s ease;
}

.ir-dropdown {
  position: relative;
}

.ir-dropdown-menu {
  display: none;
  position: absolute;
  top: calc(100% + 12px);
  left: 0;
  min-width: 270px;
  background-color: #FFFFFF;
  border: 1px solid rgba(188, 167, 99, 0.35);
  border-radius: 8px;
  box-shadow: 0 16px 36px rgba(0, 40, 20, 0.12);
  padding: 8px;
  z-index: 1010;
}

.ir-dropdown-item {
  padding: 12px 14px;
  text-decoration: none;
  border-radius: 6px;
  transition: background 0.15s ease;
}

.ir-dropdown-item:hover {
  background-color: #FAF8F2;
}

.ir-item-title {
  display: block;
  font-family: 'Inter', sans-serif;
  font-size: 14px;
  font-weight: 600;
  color: #004020;
  margin-bottom: 2px;
}

.ir-item-sub {
  display: block;
  font-family: 'Inter', sans-serif;
  font-size: 11.5px;
  color: #6B7C72;
  line-height: 1.35;
}

.ir-nav-right {
  display: flex;
  align-items: center;
}

.ir-login-btn {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 9px 18px;
  background-color: transparent;
  color: #004020;
  border: 1.5px solid #004020;
  border-radius: 6px;
  font-family: 'Inter', sans-serif;
  font-size: 13.5px;
  font-weight: 600;
  text-decoration: none;
  transition: all 0.2s ease;
}

.ir-login-btn:hover {
  background-color: #004020;
  color: #F4F1E1;
  border-color: #004020;
}

.ir-lock-icon {
  font-size: 12px;
}

.ir-ticker-bar {
  width: 100%;
  height: 38px;
  background-color: #004020;
  border-top: 1px solid rgba(188, 167, 99, 0.25);
  border-bottom: 1px solid rgba(188, 167, 99, 0.25);
  display: flex;
  align-items: center;
  position: relative;
  z-index: 990;
  overflow: hidden;
}

.ir-ticker-label {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 0 20px;
  height: 100%;
  background-color: #002D16;
  border-right: 1px solid rgba(188, 167, 99, 0.4);
  font-family: 'Inter', sans-serif;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.12em;
  color: #BCA763;
  white-space: nowrap;
  flex-shrink: 0;
  z-index: 10;
}

.ir-live-pulse {
  width: 7px;
  height: 7px;
  background-color: #10B981;
  border-radius: 50%;
  box-shadow: 0 0 8px #10B981;
}

.ir-ticker-track-wrapper {
  flex-grow: 1;
  overflow: hidden;
  position: relative;
  display: flex;
  align-items: center;
  mask-image: linear-gradient(to right, transparent, black 20px, black 95%, transparent);
}

.ir-ticker-track {
  display: flex;
  align-items: center;
  gap: 20px;
  white-space: nowrap;
  
}

}

.ir-ticker-track:hover {
  animation-play-state: paused;
}

.ir-ticker-item {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  font-family: 'Inter', sans-serif;
  font-size: 12px;
}

.ir-ticker-sym {
  font-weight: 600;
  color: #F4F1E1;
  letter-spacing: 0.04em;
}

.ir-ticker-val {
  font-weight: 500;
  color: #E2DFCE;
}

.ir-ticker-chg {
  font-weight: 600;
  padding: 1px 5px;
  border-radius: 3px;
  font-size: 11px;
}

.ir-up {
  color: #34D399;
  background-color: rgba(52, 211, 153, 0.12);
}

.ir-down {
  color: #F87171;
  background-color: rgba(248, 113, 113, 0.12);
}

.ir-gold {
  color: #E5C378;
  background-color: rgba(188, 167, 99, 0.16);
}

.ir-ticker-sep {
  color: rgba(188, 167, 99, 0.35);
  font-size: 11px;
}

.ir-hero-section {
  position: relative;
  min-height: calc(100vh - 114px);
  background-color: #02170C;
  color: #F4F1E1;
  display: flex;
  align-items: center;
  overflow: hidden;
  padding: 60px 0;
}

.ir-hero-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 1;
  pointer-events: none;
}

.ir-bg-grid {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-image: 
    linear-gradient(rgba(188, 167, 99, 0.05) 1px, transparent 1px),
    linear-gradient(90deg, rgba(188, 167, 99, 0.05) 1px, transparent 1px);
  background-size: 48px 48px;
  opacity: 0.6;
}

.ir-quant-desk-svg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.ir-vignette-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: radial-gradient(circle at 50% 45%, rgba(0, 64, 32, 0.1) 0%, rgba(2, 23, 12, 0.65) 60%, rgba(1, 14, 7, 0.95) 100%);
}

.ir-hero-container {
  position: relative;
  z-index: 10;
  width: 100%;
  max-width: 1360px;
  margin: 0 auto;
  padding: 0 36px;
}

.ir-hero-grid {
  display: grid;
  grid-template-columns: 1.1fr 0.9fr;
  gap: 56px;
  align-items: center;
}

.ir-hero-left {
  display: flex;
  flex-direction: column;
}

.ir-badge-row {
  margin-bottom: 20px;
}

.ir-reg-badge {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: rgba(188, 167, 99, 0.12);
  border: 1px solid rgba(188, 167, 99, 0.35);
  color: #BCA763;
  padding: 6px 14px;
  border-radius: 20px;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.12em;
}

.ir-gold-dot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background-color: #BCA763;
}

.ir-hero-headline {
  font-family: 'Playfair Display', Georgia, serif;
  font-size: 46px;
  line-height: 1.18;
  font-weight: 700;
  color: #F4F1E1;
  margin: 0 0 18px 0;
  letter-spacing: -0.01em;
}

.ir-headline-bar {
  color: #BCA763;
  font-weight: 400;
  margin: 0 4px;
}

.ir-headline-accent {
  color: #E5C378;
}

.ir-hero-subheadline {
  font-family: 'Inter', sans-serif;
  font-size: 18px;
  line-height: 1.6;
  color: #D6D0BC;
  margin: 0 0 32px 0;
  max-width: 560px;
}

.ir-quant-strip {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16px;
  margin-bottom: 36px;
  max-width: 580px;
}

.ir-quant-box {
  background: rgba(0, 64, 32, 0.35);
  border: 1px solid rgba(188, 167, 99, 0.25);
  border-radius: 8px;
  padding: 14px 16px;
}

.ir-quant-label {
  display: block;
  font-size: 10px;
  font-weight: 700;
  color: #BCA763;
  letter-spacing: 0.1em;
  margin-bottom: 4px;
}

.ir-quant-val {
  display: block;
  font-family: 'Playfair Display', Georgia, serif;
  font-size: 26px;
  font-weight: 700;
  color: #FFFFFF;
  line-height: 1.1;
  margin-bottom: 3px;
}

.ir-quant-sub {
  display: block;
  font-size: 11px;
  color: #9EAEA3;
}

.ir-cta-group {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.ir-btn-gold {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  background: linear-gradient(135deg, #D4AF37 0%, #BCA763 60%, #9E782F 100%);
  color: #F4F1E1;
  font-family: 'Inter', sans-serif;
  font-size: 15px;
  font-weight: 700;
  letter-spacing: 0.04em;
  text-decoration: none;
  padding: 18px 34px;
  border-radius: 6px;
  border: 1px solid #FFF1CD;
  box-shadow: 0 10px 28px rgba(188, 167, 99, 0.35);
  transition: all 0.25s ease;
  width: fit-content;
  text-transform: uppercase;
}

.ir-btn-gold:hover {
  transform: translateY(-2px);
  box-shadow: 0 14px 36px rgba(188, 167, 99, 0.45);
  background: linear-gradient(135deg, #DFC04E 0%, #C9B575 60%, #AB8537 100%);
}

.ir-btn-arrow {
  font-size: 17px;
  transition: transform 0.2s ease;
}

.ir-cta-disclaimer {
  font-size: 11.5px;
  color: #8E9F94;
  display: flex;
  align-items: center;
  gap: 6px;
}

.ir-disc-lock {
  font-size: 11px;
}

.ir-hero-right {
  display: flex;
  justify-content: center;
}

.ir-graph-card {
  width: 100%;
  max-width: 580px;
  background: rgba(3, 30, 16, 0.85);
  border: 1px solid rgba(188, 167, 99, 0.35);
  border-radius: 14px;
  padding: 24px;
  box-shadow: 0 24px 60px rgba(0, 0, 0, 0.55);
  backdrop-filter: blur(16px);
}

.ir-card-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 18px;
  padding-bottom: 14px;
  border-bottom: 1px solid rgba(188, 167, 99, 0.18);
}

.ir-card-tag {
  display: block;
  font-size: 9.5px;
  font-weight: 700;
  color: #BCA763;
  letter-spacing: 0.12em;
  margin-bottom: 4px;
}

.ir-card-h3 {
  font-family: 'Playfair Display', Georgia, serif;
  font-size: 20px;
  font-weight: 700;
  color: #F4F1E1;
  margin: 0 0 2px 0;
}

.ir-card-sub {
  font-size: 11.5px;
  color: #9EB0A5;
}

.ir-card-status {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 6px;
}

.ir-pill-live {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  background: rgba(16, 185, 129, 0.14);
  border: 1px solid rgba(16, 185, 129, 0.35);
  color: #34D399;
  font-size: 9.5px;
  font-weight: 700;
  padding: 4px 8px;
  border-radius: 4px;
  letter-spacing: 0.06em;
}

.ir-pulse-dot {
  width: 5px;
  height: 5px;
  background-color: #34D399;
  border-radius: 50%;
}

.ir-stat-big {
  font-family: 'Playfair Display', Georgia, serif;
  font-size: 20px;
  font-weight: 700;
  color: #BCA763;
}

.ir-stat-sub {
  font-family: 'Inter', sans-serif;
  font-size: 10px;
  color: #D4AF37;
  font-weight: 600;
}

.ir-svg-chart-wrap {
  width: 100%;
  margin-bottom: 16px;
}

.ir-alpha-chart-svg {
  width: 100%;
  height: auto;
  display: block;
}

.ir-card-footer {
  display: flex;
  flex-direction: column;
  gap: 14px;
  padding-top: 14px;
  border-top: 1px solid rgba(188, 167, 99, 0.18);
}

.ir-legend-group {
  display: flex;
  justify-content: space-between;
  gap: 16px;
}

.ir-legend-item {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 11px;
  color: #D6D0BC;
}

.ir-leg-line {
  display: inline-block;
  width: 18px;
  height: 3px;
  border-radius: 2px;
}

.ir-leg-gold {
  background: linear-gradient(90deg, #E5C378, #10B981);
}

.ir-leg-bench {
  background-color: #94A3B8;
  height: 2px;
  border-top: 2px dashed #94A3B8;
}

.ir-leg-num {
  font-weight: 700;
  margin-left: 4px;
}

.ir-muted {
  color: #94A3B8;
}

.ir-alpha-pill {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  background: rgba(188, 167, 99, 0.14);
  border: 1px solid rgba(188, 167, 99, 0.3);
  padding: 8px 12px;
  border-radius: 6px;
  font-size: 11.5px;
}

.ir-alpha-star {
  color: #E5C378;
}

.ir-alpha-title {
  color: #E2DFCE;
  font-weight: 500;
}

.ir-alpha-val {
  color: #E5C378;
  font-weight: 700;
}

@media screen and (max-width: 991px) {
  .ir-hero-grid {
    grid-template-columns: 1fr;
    gap: 48px;
  }

.ir-hero-headline {
    font-size: 38px;
  }

.ir-nav-menu {
    gap: 20px;
  }

}

/* Mumbai Skyline Background Enhancements */
.ir-hero-img-wrap {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  overflow: hidden;
}

.ir-hero-mumbai-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center 35%;
  filter: contrast(1.15) brightness(0.68) saturate(0.85);
  transform: scale(1.02);
}

.ir-hero-overlay-gradient {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: 
    linear-gradient(90deg, rgba(1, 23, 11, 0.95) 0%, rgba(1, 23, 11, 0.86) 42%, rgba(0, 36, 17, 0.62) 100%),
    linear-gradient(180deg, rgba(1, 23, 11, 0.85) 0%, transparent 20%, transparent 75%, rgba(1, 23, 11, 0.98) 100%),
    radial-gradient(circle at 80% 35%, rgba(188, 167, 99, 0.14) 0%, transparent 55%);
}


@keyframes irTickerScroll {
  0% { transform: translateX(0); }
  100% { transform: translateX(-50%); }
}

.ir-ticker-track {
  animation: irTickerScroll 35s linear infinite !important;
}

.ir-ticker-bar:hover .ir-ticker-track {
  animation-play-state: paused !important;
}

.ir-dropdown {
  position: relative;
}

.ir-dropdown:hover .ir-dropdown-menu {
  display: flex !important;
  opacity: 1 !important;
  pointer-events: auto !important;
  transform: translateY(0) !important;
}

.ir-dropdown:hover .ir-arrow-icon {
  transform: rotate(180deg) !important;
}

.ir-dropdown-link:hover {
  background: rgba(188, 167, 99, 0.15) !important;
  color: #FFFFFF !important;
  padding-left: 20px !important;
}

.ir-nav-link:hover {
  color: #BCA763 !important;
}

.ir-portal-btn:hover {
  background: rgba(188, 167, 99, 0.12) !important;
  border-color: #BCA763 !important;
  color: #F4F1E1 !important;
}

.ir-btn-gold:hover {
  transform: translateY(-2px) !important;
  box-shadow: 0 10px 24px rgba(188, 167, 99, 0.45) !important;
  background-color: #cbba7a !important;
}

.ir-btn-secondary:hover {
  background: rgba(255, 255, 255, 0.08) !important;
  border-color: rgba(255, 255, 255, 0.3) !important;
  color: #FFFFFF !important;
  transform: translateY(-2px) !important;
}

.ir-chart-card:hover {
  border-color: rgba(188, 167, 99, 0.4) !important;
  box-shadow: 0 24px 50px rgba(0, 0, 0, 0.5) !important;
}

.ir-metric-card:hover {
  border-color: rgba(188, 167, 99, 0.4) !important;
  transform: translateY(-2px) !important;
}
  </style>
</head>
<body style="margin: 0; padding: 0; background-color: #02170C;">
<div class="ir-master-wrap">
  <!-- Top Global Header -->
  <header class="ir-header">
    <div class="ir-nav-container">
      <!-- Left: Logo -->
      <a href="/" class="ir-logo-link" aria-label="InvestRright Capital">
        <svg class="ir-logo-svg" viewBox="0 0 500 130" xmlns="http://www.w3.org/2000/svg">
          <defs>
            <linearGradient id="irGoldLight" x1="0%" y1="0%" x2="100%" y2="100%">
              <stop offset="0%" stop-color="#FFF3D1"/>
              <stop offset="35%" stop-color="#E5C378"/>
              <stop offset="70%" stop-color="#C5A059"/>
              <stop offset="100%" stop-color="#8F6826"/>
            </linearGradient>
            <linearGradient id="irGoldDark" x1="0%" y1="0%" x2="100%" y2="100%">
              <stop offset="0%" stop-color="#DFBA73"/>
              <stop offset="50%" stop-color="#9E782F"/>
              <stop offset="100%" stop-color="#5C4212"/>
            </linearGradient>
            <linearGradient id="irArrowGreen" x1="0%" y1="100%" x2="100%" y2="0%">
              <stop offset="0%" stop-color="#062417"/>
              <stop offset="50%" stop-color="#0E5C3A"/>
              <stop offset="100%" stop-color="#1DBF7B"/>
            </linearGradient>
          </defs>

          <!-- Bull Emblem & Swooping Trend Line -->
          <g transform="translate(10, -5) scale(0.65)">
            <!-- Green Dynamic Trend Arrow -->
            <path d="M 60 100 C 110 50, 160 85, 210 105 C 260 125, 310 80, 375 20" 
                  fill="none" stroke="url(#irArrowGreen)" stroke-width="7" stroke-linecap="round"/>
            <polygon points="360,14 395,12 388,44 376,28" fill="#1DBF7B"/>

            <!-- Charging Bull -->
            <g transform="translate(10, 30) scale(0.85)">
              <path d="M 50 85 C 40 70, 45 45, 65 35 C 85 25, 120 28, 145 42 C 165 35, 195 40, 210 55 C 225 70, 220 95, 205 115 C 190 130, 160 135, 140 130 C 125 140, 95 142, 75 130 C 55 125, 45 105, 50 85 Z" fill="url(#irGoldLight)"/>
              <path d="M 135 40 C 150 25, 175 25, 195 40 C 215 55, 215 80, 200 95 C 185 80, 155 70, 135 40 Z" fill="url(#irGoldDark)" opacity="0.85"/>
              <path d="M 195 48 L 235 60 C 245 65, 248 75, 240 82 L 218 88 L 205 75 Z" fill="url(#irGoldLight)"/>
              <path d="M 215 45 C 228 32, 245 28, 260 30 C 250 38, 238 42, 225 48 Z" fill="url(#irGoldLight)"/>
              <path d="M 205 40 C 215 22, 232 15, 252 14 C 240 24, 228 30, 215 42 Z" fill="#FFF3D1"/>
              <path d="M 175 90 L 195 145 L 180 150 L 155 105 Z" fill="url(#irGoldDark)"/>
              <path d="M 190 95 L 215 135 L 202 140 L 175 102 Z" fill="url(#irGoldLight)"/>
              <path d="M 70 95 L 45 145 L 60 150 L 95 110 Z" fill="url(#irGoldDark)"/>
              <path d="M 85 90 L 75 140 L 90 143 L 110 102 Z" fill="url(#irGoldLight)"/>
              <path d="M 50 85 C 30 75, 20 50, 30 30 C 35 20, 45 15, 55 20 C 50 30, 45 45, 55 60 Z" fill="url(#irGoldDark)"/>
            </g>
          </g>

          <!-- Wordmark -->
          <text x="210" y="62" font-family="'Cinzel', 'Playfair Display', Georgia, serif" font-weight="700" font-size="34" fill="#004020" letter-spacing="1.5">
            Invest<tspan fill="#BCA763">Rright</tspan>
          </text>
          <text x="212" y="90" font-family="'Inter', sans-serif" font-weight="600" font-size="11" fill="#004020" letter-spacing="4.5">
            CAPITAL <tspan fill="#BCA763">•</tspan> AIF CAT III
          </text>
        </svg>
      </a>

      <!-- Center-Right: Navigation Menu -->
      <nav class="ir-nav-menu">
        <a href="#home" class="ir-nav-link ir-nav-active">Home</a>

        <!-- Insights Dropdown -->
        <div class="ir-dropdown">
          <a href="#insights" class="ir-nav-link ir-dropdown-toggle">
            Insights <span class="ir-arrow-icon">▾</span>
          </a>
          <div class="ir-dropdown-menu">
            <a href="#blogs" class="ir-dropdown-item">
              <span class="ir-item-title">Blogs</span>
              <span class="ir-item-sub">Macro outlook & quantitative market perspectives</span>
            </a>
            <a href="#case-studies" class="ir-dropdown-item">
              <span class="ir-item-title">Case Studies</span>
              <span class="ir-item-sub">Long-short alpha generation & trade attribution</span>
            </a>
          </div>
        </div>

        <a href="#about" class="ir-nav-link">About</a>

