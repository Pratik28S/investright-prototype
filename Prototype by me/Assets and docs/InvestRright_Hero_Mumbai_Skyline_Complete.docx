                <span class="ir-alpha-title">Alpha Delivered:</span>
                <span class="ir-alpha-val">+40.2% Excess Return</span>
              </div>
            </div>

          </div>
        </div>

      </div>
    </div>
  </section>
</div>

</body>
</html>